@inherits LayoutComponentBase

@inject IJSRuntime JS

<div class="app-shell">
    <aside class="side-nav">
        <a class="side-brand" href="/" aria-label="Painel de controle"><IfroBrand /></a>
        <div class="side-project">
            <span class="mini-key" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="4"/><path d="m11 11 9 9m-3-3 2-2m-5-1 2-2"/></svg></span>
            <span>Sistema de<br /><strong>Chaves</strong></span>
        </div>
        <nav class="side-links" aria-label="Navegação principal">
            <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span>Painel de Controle</span></NavLink>
            <NavLink href="/sistema/cadastro-chave"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="4"/><path d="m11 11 9 9m-3-3 2-2m-5-1 2-2"/></svg></span><span>Cadastrar chave</span></NavLink>
            <NavLink href="/sistema/chaves-disponiveis"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="4"/><path d="m11 11 9 9m-3-3 2-2m-5-1 2-2"/></svg></span><span>Chaves disponíveis</span></NavLink>
            <NavLink href="/sistema/retirada"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17 17 7M8 7h9v9"/></svg></span><span>Registro de uso</span></NavLink>
            <NavLink href="/sistema/devolucao"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 7 7 17m9 0H7V8"/></svg></span><span>Devolução de chave</span></NavLink>
            <NavLink href="/sistema/em-uso"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span>Chaves em uso</span></NavLink>
            <NavLink href="/sistema/atraso"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg></span><span>Chaves em atraso</span></NavLink>
            <NavLink href="/sistema/historico"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 2.6-6.4L3 8"/><path d="M3 3v5h5m4-1v5l3 2"/></svg></span><span>Histórico</span></NavLink>
            <NavLink href="/sistema/relatorios"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V4h16v16H4Z"/><path d="M8 16v-4m4 4V8m4 8v-6"/></svg></span><span>Relatórios</span></NavLink>
            <NavLink href="/sistema/usuarios"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M3 20v-1a6 6 0 0 1 12 0v1m2-12a3.5 3.5 0 0 1 0 6.8m1 2a5 5 0 0 1 3 4.2"/></svg></span><span>Usuários</span></NavLink>
            <NavLink href="/sistema/categorias"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h7l2 2h9v10H3z"/><path d="M3 7V5h7l2 2"/></svg></span><span>Categorias</span></NavLink>
            <NavLink href="/sistema/permissoes"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span><span>Permissões</span></NavLink>
            <NavLink href="/sistema/configuracoes"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1a1.8 1.8 0 0 1-2.5 2.5l-.1-.1a1.8 1.8 0 0 0-3 .9v.2a1.8 1.8 0 0 1-3.6 0v-.2a1.8 1.8 0 0 0-3-.9l-.1.1a1.8 1.8 0 0 1-2.5-2.5l.1-.1a1.8 1.8 0 0 0-.9-3h-.2a1.8 1.8 0 0 1 0-3.6h.2a1.8 1.8 0 0 0 .9-3l-.1-.1a1.8 1.8 0 0 1 2.5-2.5l.1.1a1.8 1.8 0 0 0 3-.9v-.2a1.8 1.8 0 0 1 3.6 0v.2a1.8 1.8 0 0 0 3 .9l.1-.1a1.8 1.8 0 0 1 2.5 2.5l-.1.1a1.8 1.8 0 0 0 .9 3h.2a1.8 1.8 0 0 1 0 3.6h-.2a1.8 1.8 0 0 0-.9 3Z"/></svg></span><span>Configurações</span></NavLink>
            <NavLink href="/sistema/termo"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 13h6m-6 4h6"/></svg></span><span>Termo de responsabilidade</span></NavLink>
        </nav>
        <div class="side-bottom">
            <NavLink href="/sistema/perfil"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><span>Meu perfil</span></NavLink>
            <form method="post" action="/auth/sair">
                <button class="side-logout" type="submit"><span class="nav-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 17 15 12 10 7m5 5H3"/><path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"/></svg></span><span>Sair</span></button>
            </form>
        </div>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div class="topbar-title"><strong>Sistema de Chaves</strong><small>Instituto Federal de Rondônia</small></div>
            <div class="topbar-actions">
                <a class="icon-button" href="/sistema/alertas" aria-label="Ver alertas">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
                </a>
                <div class="appearance-controls" aria-label="Preferências de exibição">
                    <button class="appearance-button" type="button" aria-label="Alternar modo escuro" aria-pressed="@_modoEscuro" title="Alternar modo escuro" @onclick="AlternarModoEscuroAsync">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14.3A8.7 8.7 0 0 1 9.7 3.5 8.8 8.8 0 1 0 20.5 14.3Z"/></svg>
                        <span>Escuro</span>
                    </button>
                    <button class="appearance-button" type="button" aria-label="Alternar modo compacto" aria-pressed="@_compacto" title="Alternar modo compacto" @onclick="AlternarModoCompactoAsync">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m4-11h5m-5 4h5"/></svg>
                        <span>Compacto</span>
                    </button>
                </div>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <a class="user-chip" href="/sistema/perfil">
                            <span class="user-avatar">@(auth.User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")</span>
                            <span class="user-chip-name">@auth.User.Identity?.Name</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _modoEscuro;
    private bool _compacto;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var preferencias = await JS.InvokeAsync<Dictionary<string, bool>>("sitePreferences.get");
            _modoEscuro = preferencias.TryGetValue("dark", out var modoEscuro) && modoEscuro;
            _compacto = preferencias.TryGetValue("compact", out var compacto) && compacto;
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task AlternarModoEscuroAsync()
    {
        _modoEscuro = !_modoEscuro;
        await SalvarPreferenciasAsync();
    }

    private async Task AlternarModoCompactoAsync()
    {
        _compacto = !_compacto;
        await SalvarPreferenciasAsync();
    }

    private Task SalvarPreferenciasAsync() =>
        JS.InvokeVoidAsync("sitePreferences.apply", _modoEscuro, _compacto).AsTask();

}
